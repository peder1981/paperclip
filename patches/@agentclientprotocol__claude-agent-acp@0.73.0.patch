+const MAX_MODEL_TOOL_OUTPUT_CHARS = 20000;
+const TOOL_OUTPUT_HEAD_CHARS = 10000;
+const TOOL_OUTPUT_TAIL_CHARS = 9000;
+function truncateToolOutput(response) {
+    const text = typeof response === "string" ? response : JSON.stringify(response);
+    if (text === undefined || text.length <= MAX_MODEL_TOOL_OUTPUT_CHARS)
+        return undefined;
+    const omitted = text.length - TOOL_OUTPUT_HEAD_CHARS - TOOL_OUTPUT_TAIL_CHARS;
+    return `${text.slice(0, TOOL_OUTPUT_HEAD_CHARS)}\n\n[Tool output truncated: ${omitted} characters omitted to stay under ${MAX_MODEL_TOOL_OUTPUT_CHARS} characters]\n\n${text.slice(-TOOL_OUTPUT_TAIL_CHARS)}`;
+}
