                 unregisterHookCallback(toolUseID);
             }
         }
+        const updatedToolOutput = truncateToolOutput(input.tool_response);
+        if (updatedToolOutput !== undefined) {
+            return { continue: true, hookSpecificOutput: { hookEventName: "PostToolUse", updatedToolOutput } };
+        }
     }
     return { continue: true };
 };
