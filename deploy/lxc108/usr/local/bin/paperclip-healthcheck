#!/bin/bash
# paperclip-healthcheck: se a API nao responder 3 vezes seguidas, reinicia o servico e avisa.
# Tambem avisa quando o disco passa de 90% (1x a cada 6h). Roda a cada 5 min pelo cron.
ST=/var/lib/paperclip-health; mkdir -p "$ST"; LOG=/var/log/paperclip-healthcheck.log
exec 9>"$ST/lock"; flock -n 9 || exit 0
code=$(curl -s -m 10 -o /dev/null -w "%{http_code}" http://127.0.0.1:3100/api/health)
if [ "$code" = "200" ]; then
  if [ -s "$ST/fails" ] && [ "$(cat "$ST/fails")" -ge 3 ]; then /usr/local/bin/paperclip-notify "[healthcheck] API do Paperclip voltou a responder." 2>/dev/null; fi
  echo 0 > "$ST/fails"
else
  n=$(( $(cat "$ST/fails" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$ST/fails"
  echo "$(date '+%F %T') health=$code fails=$n" >> "$LOG"
  if [ "$n" -eq 3 ]; then
    systemctl restart paperclip
    echo "$(date '+%F %T') RESTART paperclip (3 falhas seguidas)" >> "$LOG"
    /usr/local/bin/paperclip-notify "[healthcheck] API do Paperclip sem resposta 3x seguidas (http=$code). Servico reiniciado." 2>/dev/null
  elif [ "$n" -ge 6 ] && [ $(( n % 6 )) -eq 0 ]; then
    systemctl restart paperclip
    /usr/local/bin/paperclip-notify "[healthcheck] API do Paperclip continua fora apos reinicio ($n checagens). Intervencao necessaria." 2>/dev/null
  fi
fi
use=$(df --output=pcent / | tail -1 | tr -dc '0-9')
if [ "${use:-0}" -ge 90 ]; then
  last=$(cat "$ST/disk_notice" 2>/dev/null || echo 0); now=$(date +%s)
  if [ $(( now - last )) -ge 21600 ]; then
    /usr/local/bin/paperclip-notify "[healthcheck] Disco da LXC 108 em ${use}%. O Paperclip para de gravar se encher." 2>/dev/null
    echo "$now" > "$ST/disk_notice"
  fi
fi
