[Unit]
Description=Homelab iptables FORWARD rules (wt0 <-> vmbr0 LXC subnet)
After=netbird.service netfilter-persistent.service
Wants=netbird.service

[Service]
Type=oneshot
RemainAfterExit=yes
# ip_forward
ExecStart=/sbin/sysctl -w net.ipv4.ip_forward=1
# FORWARD wt0→vmbr0 (idempotente via -C antes de -A)
ExecStart=/bin/sh -c "iptables -C FORWARD -i wt0 -o vmbr0 -j ACCEPT 2>/dev/null || iptables -I FORWARD 3 -i wt0 -o vmbr0 -j ACCEPT"
ExecStart=/bin/sh -c "iptables -C FORWARD -i vmbr0 -o wt0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -I FORWARD 4 -i vmbr0 -o wt0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT"

[Install]
WantedBy=multi-user.target
