[Unit]
Description=Ernesto AdvPP Code Assistant (ernesto-granite41-rag)
After=network-online.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ernesto-rag
ExecStart=/usr/bin/python3 /opt/ernesto-rag/advpp_assistant.py
Restart=on-failure
StartLimitBurst=3
EnvironmentFile=/opt/ernesto-rag/.env
Environment="LLAMA_MODEL=ernesto-granite41-rag"
Environment="OLLAMA_URL=http://127.0.0.1:11434"
Environment="ASSISTANT_PORT=9090"
Environment="HOST_ADDRESS=127.0.0.1"

[Install]
WantedBy=default.target
