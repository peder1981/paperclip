Unit]
Description=RAG Proxy (Protheus Q&A)]
After=ollama.service chroma.service mem0.service mcp.service]
Service]
Type=simple]
WorkingDirectory=/opt/ernesto-rag]
ExecStart=/mnt/ernesto-data/chroma_db/ernesto-rag-venv/bin/python3 /opt/ernesto-rag/launch_rag.py]
Restart=always]
RestartSec=5]
Install]
WantedBy=multi-user.target]
