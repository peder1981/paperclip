[Unit]
Description=AMD GPU — COMPUTE profile + SCLK cap 1520 MHz
After=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/bin/sleep 10
ExecStart=/bin/sh -c '\
  echo 5 > /sys/class/drm/card1/device/pp_power_profile_mode && \
  echo manual > /sys/class/drm/card1/device/power_dpm_force_performance_level && \
  echo "s 1 1520" > /sys/class/drm/card1/device/pp_od_clk_voltage && \
  echo c > /sys/class/drm/card1/device/pp_od_clk_voltage'

[Install]
WantedBy=multi-user.target
