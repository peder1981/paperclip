#!/bin/bash
MODEL="${1:-llama3.2:1b}"
read -r PROMPT

curl -s -X POST http://127.0.0.1:11434/v1/chat/completions \
  -H "Content-Type: application/json" \
  --data-raw "{\"model\":\"$MODEL\",\"messages\":[{\"role\":\"user\",\"content\":\"$PROMPT\"}],\"stream\":false}" | jq -r '.choices[0].message.content'
