#!/bin/bash
# telegram-notify — envia alerta via Telegram bot
# Uso: telegram-notify "mensagem"
#      echo "mensagem" | telegram-notify
# Config: /etc/telegram-notify.conf

CONF=/etc/telegram-notify.conf

if [ ! -f "$CONF" ]; then
    echo "telegram-notify: config not found at $CONF" >&2
    echo "Create it with: TELEGRAM_BOT_TOKEN=xxx TELEGRAM_CHAT_ID=xxx" >&2
    exit 1
fi

. "$CONF"

if [ -z "$TELEGRAM_BOT_TOKEN" ] || [ -z "$TELEGRAM_CHAT_ID" ]; then
    echo "telegram-notify: TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID required" >&2
    exit 1
fi

MSG="${1:-$(cat)}"
if [ -z "$MSG" ]; then
    echo "telegram-notify: no message provided" >&2
    exit 1
fi

# Escape HTML special chars to prevent Telegram API silent failures
MSG=$(echo "$MSG" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')

curl -s -o /dev/null -w "%{http_code}" \
    "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
    -d "chat_id=${TELEGRAM_CHAT_ID}" \
    -d "text=${MSG}" \
    -d "parse_mode=HTML" | grep -q 200 && exit 0
exit 1
